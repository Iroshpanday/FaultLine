# Copy to .env and fill in real values. .env is git-ignored; this file is not.
# Never put real secrets in this file.

# Dev falls back to an insecure key if unset; prod refuses to start without it.
DJANGO_SECRET_KEY=change-me
# Prod only: comma-separated hostnames.
DJANGO_ALLOWED_HOSTS=localhost

# PostgreSQL. The user needs CREATEDB so pytest can create test_<POSTGRES_DB>.
POSTGRES_DB=faultline
POSTGRES_USER=faultline
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Store prompts/responses in the DB (dev default: on; prod default: off).
STORE_PROMPTS=true

# OpenRouter (https://openrouter.ai/keys). Real key goes in .env only.
OPENROUTER_API_KEY=sk-or-change-me
# Must support tool calling. The ":free" suffix is the free variant.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_TIMEOUT_SECONDS=30

# Chat endpoint limit per client (it spends LLM money on every request).
CHAT_THROTTLE_RATE=10/min
# Proxies in front of Django. 0 in dev; 1 in prod behind exactly one proxy.
NUM_PROXIES=0
